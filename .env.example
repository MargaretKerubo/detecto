# Detecto – Example environment configuration
# Copy this file to .env and fill in your values.

# URL that the FastAPI CORS middleware will allow
FRONTEND_ORIGIN=http://localhost:5173

# Minimum confidence threshold for person detections (0.0 – 1.0)
CONFIDENCE_THRESHOLD=0.4

# Path to the YOLOv8 weights file (downloaded automatically if not present)
YOLO_MODEL_PATH=yolov8n.pt

# SQLite database path (relative to backend/)
DATABASE_URL=sqlite:///./detecto.db
